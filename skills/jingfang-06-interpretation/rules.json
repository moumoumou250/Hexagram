    },
    {
      "id": "R08",
      "status": "fixed",
      "source": "生旺墓绝章",
      "enabled": true,
      "trigger": "stage",
      "template": "{who}在{actor}上见到{stage}。本系统只用长生、帝旺、墓、绝四位。"
    },
    {
      "id": "R09",
      "status": "fixed",
      "source": "生旺墓绝章",
      "enabled": false,
      "trigger": "manual",
      "template": "{who}虽见绝或墓，但若本身旺，先按能生看，不先按死绝看。"
    },
    {
      "id": "R10",
      "status": "fixed",
      "source": "动变生克冲合章",
      "enabled": true,
      "trigger": "has_moves",
      "template": "变爻主要管自己本位的动爻，不去直接管别的爻。只有月、日能管到变爻。"
    },
    {
      "id": "R11",
      "status": "fixed",
      "source": "题头总注章",
      "enabled": true,
