{
  "version": "1.0",
  "forbidden_matter_terms": [
    "升职", "获聘", "录取", "复合", "分手", "结婚", "病愈", "痊愈", "得财", "发财",
    "一定", "必成", "必败", "会失败", "会成功", "对方会", "这件事会"
  ],
  "rules": [
    {
      "id": "R01",
      "status": "fixed",
      "source": "四时旺相章",
      "enabled": true,
      "trigger": "month_strength",
      "template": "{who}在月令里是{state}。{gloss}"
    },
    {
      "id": "R02",
      "status": "fixed",
      "source": "月破章",
      "enabled": true,
      "trigger": "month_break",
      "template": "{who}被月建冲掉（月破）。{how}"
    },
    {
      "id": "R03",
      "status": "fixed",
      "source": "月破章",
      "enabled": false,
      "trigger": "manual",
      "template": "{who}虽与月建同五行，仍按月破看，不按旺看。"
    },
    {
      "id": "R04",
      "status": "fixed",
      "source": "日辰章",
      "enabled": true,
      "trigger": "day_lifts_month_break",
      "template": "{who}临着日辰。月破这层可以先放松看。"
    },
    {
      "id": "R05",
      "status": "heuristic",
      "source": "日辰章、暗动章",
      "enabled": true,
      "trigger": "day_chong_static",
      "template": "{who}安静却被日冲。{how}"
    },
    {
      "id": "R06",
      "status": "fixed",
      "source": "动散章",
      "enabled": true,
      "trigger": "moving_day_chong",
