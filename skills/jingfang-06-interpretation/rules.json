    {
      "id": "X01",
      "status": "fixed",
      "source": "飞伏神章",
      "enabled": true,
      "trigger": "always_once",
      "template": "互卦、天干合化：不用来找用神。"
    },
    {
      "id": "X02",
      "status": "fixed",
      "source": "六神章",
      "enabled": true,
      "trigger": "always_once",
