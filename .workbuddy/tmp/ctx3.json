osition": 5, "relative": "父母", "branch": "子", "element": "水", "role": "父母", "force": "有力", "reasons": ["旺相"], "rooted": null}, {"position": 6, "relative": "兄弟", "branch": "寅", "element": "木", "role": "仇神", "force": "有力", "reasons": ["六爻寅木临日辰，程序只按酉月木休囚判无力，未计临日辰"], "rooted": null, "force_override": "有力", "override_reason": "六爻寅木临日辰，程序只按酉月木休囚判无力，未计临日辰"}], "primary_rooted": "有根", "primary_rooted_reasons": []}, "refs": []}, {"id": 18, "step": "focus", "kind": "judgment", "topic": "roles", "summary": "所问为求见能办事的贵人，官鬼主功名官府、一切拘束我者，全卦官鬼只三爻辛酉一现且持世，取三爻官鬼酉金为主用神；原神为土，一爻丑、四爻戌两现；忌神为火，只五爻下伏辛巳子孙与三爻变爻戊午，伏神受飞神子水克；仇神为木，六爻寅木临应", "detail": {"condition": "求见之人在卦中无亲属名分，以官鬼为用；官鬼一现且持世，不涉两现取舍", "exceptions": null, "skill": "skills/jingfang-02-focus/SKILL.md", "section": "操作", "rule": "官鬼为功名官府、一切拘束我者；自占看世，问他人看应；原神生用神、忌神克用神、仇神克原神而生忌神"}, "refs": [10, 13]}, {"id": 19, "step": "strength", "kind": "judgment", "topic": "strength", "summary": "主用神即世爻三爻官鬼辛酉金，酉月临月建为旺，帝旺于月；日辰寅木于金为绝地，旺相遇绝论生不论绝，反是酉金克寅木；用神持世，世用同位", "detail": {"condition": "月建酉、日辰丙寅，用神为上卦三爻酉金", "exceptions": null, "skill": "skills/jingfang-03-strength/SKILL.md", "section": "操作", "rule": "临月建为旺；只用长生、帝旺、墓、绝四位；旺相遇绝论生不论绝；用神持世则世用一体", "force_override": "有力", "override_reason": "程序默认因化回头克判为无力，与临月建旺相、有根不符；回头克属动变之伤，留待动变步处理", "position": 3}, "refs": [9, 10, 12]}, {"id": 20, "step": "strength", "kind": "judgment", "topic": "strength", "summary": "原神为土，一爻辛丑、四爻丙戌两现，酉月土休囚，日辰寅木克丑、克戌，两爻皆静，无力生用；四爻戌土又落旬空（戌、亥空）", "detail": {"condition": "所取用神为官鬼金，原神为妻财土", "exceptions": null, "skill": "skills/jingfang-03-strength/SKILL.md", "section": "操作", "rule": "原神休囚不动、休囚又空破者不能生用；月令旺衰按 month_strength，酉月土休囚"}, "refs": [9, 10, 12]}, {"id": 21, "step": "strength", "kind": "judgment", "topic": "strength", "summary": "忌神子孙火不上卦，只五爻父母子水下伏辛巳火，飞神子水克伏，伏神受制；仇神兄弟寅木居六爻临应，又临日辰，克原神之土而生忌神之火，仇神有力", "detail": {"condition": "忌神子孙、仇神兄弟在本卦的取位与伏神位置按固定盘", "exceptions": null, "skill": "skills/jingfang-03-strength/SKILL.md", "section": "操作", "rule": "伏神受飞神克为受制；仇神克原神而生忌神；爻临日辰为旺", "force_override": "有力", "override_reason": "六爻寅木临日辰，程序只按酉月木休囚判无力，未计临日辰", "position": 6}, "refs": [9, 10, 12]}, {"id": 22, "step": "strength", "kind": "judgment", "topic": "strength", "summary": "世在三爻官鬼酉金，应在六爻兄弟寅木，金克木为世克应；世临月建、应临日辰，两皆有气", "detail": {"condition": "本卦世三应六", "exceptions": null, "skill": "skills/jingfang-03-strength/SKILL.md", "section": "操作", "rule": "以 shi_ying 定位世应；世克应、应克世按五行生克"}, "refs": [10, 12]}, {"id": 23, "step": "change", "kind": "judgment", "topic": "moving_line", "summary": "三爻辛酉金独发化戊午火，同爻子孙午火回头克酉金；变爻午火酉月休囚，却得日辰寅木长生，克力不减，用神虽临月建而有伤，属有根受伤而非无根", "detail": {"condition": "本卦只三爻一爻发动，move_mask=4，变卦山水蒙", "exceptions": null, "skill": "skills/jingfang-04-change/SKILL.md", "section": "操作", "rule": "变爻只生克本位动爻，他爻不能生克变爻，惟月建日辰能生克之；化回头克为化凶", "position": 3, "changed_branch": "午"}, "refs": [9, 11, 12]}, {"id": 24, "step": "change", "kind": "judgment", "topic": "moving_line", "summary": "动爻酉金本可克应爻兄弟寅木，化午火回头克后自顾不暇，克应之力被制；用神持世受本位变爻所克，须待制住午火方可解", "detail": {"condition": "三爻为世兼用神，六爻寅木为应", "exceptions": null, "skill": "skills/jingfang-04-change/SKILL.md", "section": "操作", "rule": "动爻能生克静爻与他动爻；变爻回头克则本爻原有力道受制", "position": 3, "changed_branch": "午"}, "refs": [10, 11, 12]}, {"id": 25, "step": "change", "kind": "judgment", "topic": "change", "summary": "本卦山风蛊变山水蒙，只此一爻独发，无爻之反吟伏吟，卦级无六冲六合之变、无卦变生克，独发只作参考而不舍用神", "detail": {"condition": "内卦巽变坎，外卦艮不动", "exceptions": null, "skill": "skills/jingfang-04-change/SKILL.md", "section": "操作", "rule": "反吟取经卦动后三支逐位相冲，伏吟取逐位相同；独发、独静只作参考"}, "refs": [10, 11, 15]}, {"id": 26, "step": "timing", "kind": "judgment", "topic": "window", "summary": "用神酉金旺而受本位变爻午火回头克，取克神受克之日，子水冲克午火，首选子日", "detail": {"condition": "用神有根而受回头克，克神为变爻午火", "exceptions": null, "skill": "skills/jingfang-05-timing/SKILL.md", "section": "操作", "rule": "大象吉而受克，待克神受克之日；亦可取冲去伤爻之日", "branch": "子", "unit": "日", "channel": "克神受克"}, "refs": [11, 12, 17]}, {"id": 27, "step": "timing", "kind": "judgment", "topic": "window", "summary": "次选辰日：辰与酉合，用神动而逢合，且辰土生酉金，合而带生，惟须午火先受制", "detail": {"condition": "用神为动爻，辰酉六合", "exceptions": null, "skill": "skills/jingfang-05-timing/SKILL.md", "section": "操作", "rule": "动而逢值、逢合；从合处取应期", "branch": "辰", "unit": "日", "channel": "合"}, "refs": [11, 12]}, {"id": 28, "step": "timing", "kind": "fact", "topic": "windows", "summary": "应期窗口与通道置信度", "detail": {"windows": [{"branch": "子", "unit": "日", "channels": ["克神受克"], "confidence": "candidate", "summaries": ["用神酉金旺而受本位变爻午火回头克，取克神受克之日，子水冲克午火，首选子日"], "refs": [11, 12, 17]}, {"branch": "辰", "unit": "日", "channels": ["合"], "confidence": "candidate", "summaries": ["次选辰日：辰与酉合，用神动而逢合，且辰土生酉金，合而带生，惟须午火先受制"], "refs": [11, 12]}]}, "refs": []}], "focus": {"relative": "官鬼", "candidates": [{"source": "base", "position": 3, "branch": "酉", "element": "金"}, {"source": "month", "position": null, "branch": "酉", "element": "金"}], "primary": {"source": "base", "position": 3, "branch": "酉", "element": "金"}, "roles": {"yongshen": "官鬼", "yuanshen": "妻财", "jishen": "子孙", "choushen": "兄弟"}}, "verdict": null, "checks": ["用神候选多现，核对取舍和影响", "第 3 爻含回头克或化合，复核对世用的影响", "独发一爻，核对独发用神与应期", "原神第1爻判定为无力（休囚、非动）", "原神第4爻判定为无力（休囚、非动）", "金局巳、酉、丑为虚一待用，核对三合虚实", "火局寅、午、戌为虚局，核对三合虚实", "应期通道未见当令或填实，核对是否缺落点（告警不阻断）"], "claims": {"checked": 15, "conflicts": [{"entry_id": 23, "claim": "子孙午火", "expected": "妻财丑土、父母亥水、官鬼酉金、妻财戌土、父母子水、兄弟寅木", "actual": "子孙午火"}]}, "database": {"gua_record": {"gua_id": "5833b94f2e6f47e1b92dd59b4daf5e3a", "rule_version": "027109b10cf9c69132558b5bb538316948536a28db1426ee80a766147c6d52b8", "revision": 2, "record_digest": "afcfbcd1cd9869230cde7937615e0641a71971f0e624478d8b3cba70f635e0d6", "question": "想请人引见一位能办事的贵人，这次能不能见到", "question_category": null, "divine_time": null, "month_branch": "酉", "day_ganzhi": "丙寅", "hexagram_id": 18, "move_mask": 4, "yong_liuqin": "官鬼", "yong_source": "base", "yong_position": 3, "yong_basis": "所问为求见能办事的贵人，官鬼主功名官府、一切拘束我者，全卦官鬼只三爻辛酉一现且持世，取三爻官鬼酉金为主用神；原神为土，一爻丑、四爻戌两现；忌神为火，只五爻下伏辛巳子孙与三爻变爻戊午，伏神受飞神子水克；仇神为木，六爻寅木临应", "ying_qi_basis": "克神受克、合", "ying_qi": "子日、辰日", "verdict": null, "verdict_text": null, "ve